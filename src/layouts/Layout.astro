---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Generate breadcrumbs from URL
const currentPath = new URL(Astro.request.url).pathname;
const pathSegments = currentPath.split("/").filter(Boolean);
const breadcrumbs = [{ name: "Accueil", path: "/" }];

pathSegments.forEach((segment, index) => {
  const path = "/" + pathSegments.slice(0, index + 1).join("/");
  const name = segment.charAt(0).toUpperCase() + segment.slice(1);
  breadcrumbs.push({ name, path });
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Site de film</title>
  </head>
  <body>
    <nav class="max-w-6xl mx-auto px-8 py-4 border-b border-gray-200">
      <div class="flex items-center gap-2 text-sm">
        {
          breadcrumbs.map((crumb, index) => (
            <div class="flex items-center gap-2">
              {index > 0 && <span class="text-gray-400">/</span>}
              <a href={crumb.path} class="hover:underline text-gray-700">
                {crumb.name}
              </a>
            </div>
          ))
        }
      </div>
    </nav>
    <slot />
  </body>
</html>

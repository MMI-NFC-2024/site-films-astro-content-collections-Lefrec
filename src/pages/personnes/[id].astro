---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
  calculateAge,
  formatDate,
  getRegionName,
  joinWithAnd,
} from "../../helper";
import { Image } from "astro:assets";
import LinkFilm from "../../components/LinkFilm.astro";
import ListeFilms from "../../components/ListeFilms.astro";

export async function getStaticPaths() {
  const personnes = await getCollection("personnes");
  return personnes.map((personne) => ({
    params: { id: personne.id },
    props: { personne },
  }));
}

const { personne } = Astro.props;
const { Content } = await render(personne);

const filmRealisateur = await getCollection("films", function (film) {
  return film.data.realisateur?.id === personne.id;
});

const filmProducteur = await getCollection("films", function (film) {
  return film.data.producteurs?.some((p) => p.id == personne.id);
});

const filmRole = await getCollection("films", (film) => film.data.roles?.some((p) => p.acteur.id === personne.id));
---

<Layout title={personne.data.nom}>
  <div class="max-w-4xl mx-auto p-8">
    <h1 class="text-4xl font-bold mb-4">{personne.data.nom}</h1>
    <!-- Date de naissance -->
    <p>
      Né le {formatDate(personne.data.naissance)}
      {
        !personne.data.décès && (
          <span>âge : {calculateAge(personne.data.naissance)}</span>
        )
      }
    </p>
    <!-- Date de décès optionnelle -->
    {
      personne.data.décès && (
        <p>
          Décédé le {formatDate(personne.data.décès)} à l'âge fatidique de
          {calculateAge(personne.data.naissance, personne.data.décès)} ans.
        </p>
      )
    }
    <!-- Professions -->
    {
      personne.data.professions && (
        <p>
          Profession{personne.data.professions.length > 1 ? "s" : ""} :{" "}
          {joinWithAnd(personne.data.professions)}
        </p>
      )
    }
    <!-- Lieu de naissance -->
    {
      personne.data.lieu_naissance && (
        <p>Lieu de naissance : {getRegionName(personne.data.lieu_naissance)}</p>
      )
    }
    <!-- Image -->
    {
      personne.data.image && (
        <Image src={personne.data.image} alt={personne.data.nom} class="my-6" />
      )
    }
    <!-- Films réalisés -->
    {
      filmRealisateur.length > 0 && (
        <h3>Films réalisés :</h3>
        <ListeFilms films={filmRealisateur}/>
      )
    }
    <!-- Films produits -->
    {
      filmProducteur.length > 0 && (
        <h3>Films produits :</h3>
        <ListeFilms films={filmProducteur}/>
      )
    }
      <!-- Films joués -->
    {
      filmRole.length > 0 && (
        filmRole.map((film) => (
          <>
            A joué le role de {
              film.data.roles
                ?.filter(role => role.acteur.id === personne.id)
                .map((role)=>role.nom_role)
              } dans {film.data.titre}
          </>
        ))
      )
    }
    <!-- Contenu MarkDown -->
    <div class="prose max-w-none">
      <Content />
    </div>
  </div>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import placeholder from "../../assets/images/placeholder.png";

const personnes = await getCollection("personnes");
---

<Layout title="Personnes">
  <div class="max-w-6xl mx-auto p-8">
    <h1 class="text-4xl font-bold mb-8">Personnes</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        personnes.map((personne) => (
          <a href={`/personnes/${personne.id}`}>
            <div class="border border-gray-300 rounded-lg overflow-hidden">
              {personne.data.photo && (
                <Image
                  src={personne.data.photo ?? placeholder}
                  alt={personne.data.nom}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-4">
                <h2 class="text-lg font-semibold">{personne.data.nom}</h2>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

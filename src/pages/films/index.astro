---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import placeholder from "../../assets/images/placeholder.png";

const films = await getCollection("films");
---

<Layout title="Films">
  <div class="max-w-6xl mx-auto p-8">
    <h1 class="text-4xl font-bold mb-8">Films</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        films.map((film) => (
          <a href={`/films/${film.id}`}>
            <div class="border border-gray-300 rounded-lg overflow-hidden">
              <Image
                src={film.data.image ?? placeholder}
                alt={film.data.titre}
                class="w-full h-48 object-cover"
              />
              <div class="p-4">
                <h2 class="text-lg font-semibold mb-2">{film.data.titre}</h2>
                {film.data.genres && (
                  <div class="flex flex-wrap gap-2">
                    {film.data.genres.map((genre: string) => (
                      <span class="text-xs bg-gray-100 px-2 py-1 rounded border border-gray-300">
                        {genre}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Index">
  <div class="max-w-4xl mx-auto p-8">
    <h1 class="text-4xl font-bold mb-4">
      Bienvenue sur le TP de gestion de contenu Astro
    </h1>
    <p class="mb-2">
      Le but de ce TP est d'apprendre à gérer des contenus et des collections en
      MarkDown avec Astro
    </p>
    <div class="flex gap-4">
      <a href="/personnes" class="border border-gray-300 px-6 py-3 rounded"
        >Liste des personnes</a
      >
      <a href="/films" class="border border-gray-300 px-6 py-3 rounded"
        >Liste des films</a
      >
    </div>
  </div>
</Layout>
